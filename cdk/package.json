{
  "name": "superwerker-cdk",
  "packageManager": "yarn@4.17.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "synth": "cdk synth --version-reporting false",
    "test": "make test && tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "publish-assets": "npx tsx src/scripts/publish-assets.ts",
    "prepare": "cd .. && husky cdk/.husky",
    "lint": "eslint . --fix",
    "format": "prettier --write --ignore-unknown ."
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/async-retry": "^1.4.9",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "chalk": "^5",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "json-schema": "^0.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix",
    "*.{json,js,ts,jsx,tsx,html}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-python-alpha": "^2.261.0-alpha.0",
    "@aws-sdk/client-cloudwatch": "^3.940.0",
    "@aws-sdk/client-controltower": "^3.940.0",
    "@aws-sdk/client-eventbridge": "^3.940.0",
    "@aws-sdk/client-organizations": "^3.940.0",
    "@aws-sdk/client-securityhub": "^3.940.0",
    "@aws-sdk/client-ses": "^3.940.0",
    "@aws-sdk/client-sns": "^3.940.0",
    "@aws-sdk/client-ssm": "^3.940.0",
    "@aws-sdk/client-sts": "^3.940.0",
    "@aws-sdk/credential-provider-node": "^3.894.0",
    "@types/aws-lambda": "^8.10.159",
    "async-retry": "^1.3.3",
    "aws-cdk": "^2.1130.0",
    "aws-cdk-lib": "^2.261.0",
    "axios": "^1.13.2",
    "cdk-assets": "^4.2.2",
    "cdk-nag": "^2.37.55",
    "constructs": "^10.5.0",
    "endent": "^2.1.0",
    "exponential-backoff": "^3.1.3",
    "handlebars": "^4.7.8",
    "uuid4": "^2.0.3",
    "yaml": "^2.8.1"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "resolutions": {
    "@vitest/expect": "4.1.10"
  }
}
