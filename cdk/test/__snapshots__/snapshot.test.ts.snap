exports[`templates > SuperwerkerStack/GuardDuty matches snapshot 1`] = `
{
  "Resources": {
    "EnableGuardDutyExistingAccounts": {
      "Properties": {
        "Content": {
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "ListDetectors",
                "Service": "guardduty",
              },
              "name": "GetDetectorId",
              "outputs": [
                {
                  "Name": "DetectorId",
                  "Selector": "$.DetectorIds[0]",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "AccountId": "{{ ManagementAWSAccountId }}",
                "Api": "DescribeAccount",
                "Service": "organizations",
              },
              "name": "ManagementAWSAccount",
              "outputs": [
                {
                  "Name": "EmailAddress",
                  "Selector": "$.Account.Email",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "AccountId": "{{ LogArchiveAWSAccountId }}",
                "Api": "DescribeAccount",
                "Service": "organizations",
              },
              "name": "LogArchiveAWSAccount",
              "outputs": [
                {
                  "Name": "EmailAddress",
                  "Selector": "$.Account.Email",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "AccountDetails": [
                  {
                    "AccountId": "{{ ManagementAWSAccountId }}",
                    "Email": "{{ ManagementAWSAccount.EmailAddress }}",
                  },
                  {
                    "AccountId": "{{ LogArchiveAWSAccountId }}",
                    "Email": "{{ LogArchiveAWSAccount.EmailAddress }}",
                  },
                ],
                "Api": "CreateMembers",
                "DetectorId": "{{ GetDetectorId.DetectorId }}",
                "Service": "guardduty",
              },
              "name": "CreateMembers",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "UpdateOrganizationConfiguration",
                "AutoEnable": true,
                "DetectorId": "{{ GetDetectorId.DetectorId }}",
                "Service": "guardduty",
              },
              "name": "EnableGuardDutyExistingAccounts",
            },
          ],
          "parameters": {
            "LogArchiveAWSAccountId": {
              "type": "String",
            },
            "ManagementAWSAccountId": {
              "type": "String",
            },
          },
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "EnableGuardDutyOrganizations": {
      "Properties": {
        "Content": {
          "assumeRole": {
            "Fn::GetAtt": [
              "EnableGuardDutyOrganizationsRole",
              "Arn",
            ],
          },
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "ListOrganizationAdminAccounts",
                "Service": "guardduty",
              },
              "name": "CheckIfOrganizationAdminAccountIsAlReadyRegistered",
              "nextStep": "EnableOrganizationAdminAccountChoice",
              "outputs": [
                {
                  "Name": "AdminAccountId",
                  "Selector": "$.AdminAccounts[0].AdminAccountId",
                },
              ],
            },
            {
              "action": "aws:branch",
              "inputs": {
                "Choices": [
                  {
                    "NextStep": "EnableGuardDutyInManagementAccount",
                    "StringEquals": "{{ AuditAccountId }}",
                    "Variable": "{{ CheckIfOrganizationAdminAccountIsAlReadyRegistered.AdminAccountId }}",
                  },
                ],
                "Default": "EnableOrganizationAdminAccount",
              },
              "name": "EnableOrganizationAdminAccountChoice",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "AdminAccountId": "{{ AuditAccountId }}",
                "Api": "EnableOrganizationAdminAccount",
                "Service": "guardduty",
              },
              "name": "EnableOrganizationAdminAccount",
            },
            {
              "action": "aws:waitForAwsResourceProperty",
              "inputs": {
                "Api": "ListDelegatedAdministrators",
                "DesiredValues": [
                  "ACTIVE",
                ],
                "PropertySelector": "$.DelegatedAdministrators[0].Status",
                "Service": "organizations",
                "ServicePrincipal": "guardduty.amazonaws.com",
              },
              "name": "WaitForEnableOrganizationAdminAccount",
              "timeoutSeconds": "60",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "CreateDetector",
                "Enable": true,
                "Service": "guardduty",
              },
              "name": "EnableGuardDutyInManagementAccount",
            },
            {
              "action": "aws:sleep",
              "inputs": {
                "Duration": "PT120S",
              },
              "name": "SleepEnableGuardDutyExistingAccounts",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "StartAutomationExecution",
                "DocumentName": {
                  "Ref": "EnableGuardDutyS3DataProtectionForOrganization",
                },
                "Service": "ssm",
                "TargetLocations": [
                  {
                    "Accounts": [
                      "{{ AuditAccountId }}",
                    ],
                    "ExecutionRoleName": "AWSControlTowerExecution",
                    "Regions": [
                      {
                        "Ref": "AWS::Region",
                      },
                    ],
                  },
                ],
              },
              "name": "EnableGuardDutyS3DataProtectionForOrganization",
              "outputs": [
                {
                  "Name": "AutomationExecutionId",
                  "Selector": "$.AutomationExecutionId",
                },
              ],
            },
            {
              "action": "aws:waitForAwsResourceProperty",
              "inputs": {
                "Api": "DescribeAutomationExecutions",
                "DesiredValues": [
                  "Success",
                ],
                "Filters": [
                  {
                    "Key": "ExecutionId",
                    "Values": [
                      "{{ EnableGuardDutyS3DataProtectionForOrganization.AutomationExecutionId }}",
                    ],
                  },
                ],
                "PropertySelector": "$.AutomationExecutionMetadataList[0].AutomationExecutionStatus",
                "Service": "ssm",
              },
              "name": "WaitForEnableGuardDutyS3DataProtectionForOrganization",
              "timeoutSeconds": "60",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "StartAutomationExecution",
                "DocumentName": {
                  "Ref": "EnableGuardDutyExistingAccounts",
                },
                "Parameters": {
                  "LogArchiveAWSAccountId": [
                    "{{ LogArchiveAccountId }}",
                  ],
                  "ManagementAWSAccountId": [
                    {
                      "Ref": "AWS::AccountId",
                    },
                  ],
                },
                "Service": "ssm",
                "TargetLocations": [
                  {
                    "Accounts": [
                      "{{ AuditAccountId }}",
                    ],
                    "ExecutionRoleName": "AWSControlTowerExecution",
                    "Regions": [
                      {
                        "Ref": "AWS::Region",
                      },
                    ],
                  },
                ],
              },
              "name": "EnableGuardDutyExistingAccounts",
              "outputs": [
                {
                  "Name": "AutomationExecutionId",
                  "Selector": "$.AutomationExecutionId",
                },
              ],
            },
            {
              "action": "aws:waitForAwsResourceProperty",
              "inputs": {
                "Api": "DescribeAutomationExecutions",
                "DesiredValues": [
                  "Success",
                ],
                "Filters": [
                  {
                    "Key": "ExecutionId",
                    "Values": [
                      "{{ EnableGuardDutyExistingAccounts.AutomationExecutionId }}",
                    ],
                  },
                ],
                "PropertySelector": "$.AutomationExecutionMetadataList[0].AutomationExecutionStatus",
                "Service": "ssm",
              },
              "name": "WaitForEnableGuardDutyExistingAccounts",
              "timeoutSeconds": "60",
            },
          ],
          "parameters": {
            "AuditAccountId": {
              "default": "{{ssm:/superwerker/account_id_audit}}",
              "type": "String",
            },
            "LogArchiveAccountId": {
              "default": "{{ssm:/superwerker/account_id_logarchive}}",
              "type": "String",
            },
          },
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "EnableGuardDutyOrganizationsRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "guardduty:EnableOrganizationAdminAccount",
                    "guardduty:ListOrganizationAdminAccounts",
                    "guardduty:CreateDetector",
                    "organizations:EnableAWSServiceAccess",
                    "organizations:ListAWSServiceAccessForOrganization",
                    "organizations:ListDelegatedAdministrators",
                    "organizations:RegisterDelegatedAdministrator",
                    "organizations:DescribeOrganization",
                    "ssm:DescribeAutomationExecutions",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "EnableAWSServiceAccess",
          },
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:StartAutomationExecution",
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":ssm:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":automation-definition/",
                          {
                            "Ref": "EnableGuardDutyExistingAccounts",
                          },
                          ":*",
                        ],
                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":ssm:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":automation-definition/",
                          {
                            "Ref": "EnableGuardDutyS3DataProtectionForOrganization",
                          },
                          ":*",
                        ],
                      ],
                    },
                  ],
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "AllowStartAutomationExecution",
          },
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "sts:AssumeRole",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":iam::*:role/AWSControlTowerExecution",
                      ],
                    ],
                  },
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "AllowCallCrossAccountAutomation",
          },
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:GetParameters",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:",
                        {
                          "Ref": "AWS::Region",
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId",
                        },
                        ":parameter/superwerker/*",
                      ],
                    ],
                  },
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "SSMParameters",
          },
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "iam:CreateServiceLinkedRole",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":iam::",
                        {
                          "Ref": "AWS::AccountId",
                        },
                        ":role/aws-service-role/guardduty.amazonaws.com/AWSServiceRoleForAmazonGuardDuty",
                      ],
                    ],
                  },
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "ServiceLinkedRole",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "EnableGuardDutyS3DataProtectionForOrganization": {
      "Properties": {
        "Content": {
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "ListDetectors",
                "Service": "guardduty",
              },
              "name": "GetDetectorId",
              "outputs": [
                {
                  "Name": "DetectorId",
                  "Selector": "$.DetectorIds[0]",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "UpdateOrganizationConfiguration",
                "AutoEnable": true,
                "DataSources": {
                  "S3Logs": {
                    "AutoEnable": true,
                  },
                },
                "DetectorId": "{{ GetDetectorId.DetectorId }}",
                "Service": "guardduty",
              },
              "name": "EnableGuardDutyS3DataProtectionForOrganization",
            },
          ],
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "LandingZoneSetupFinishedTrigger": {
      "Properties": {
        "EventPattern": {
          "detail": {
            "eventName": [
              "LandingZoneSetupOrUpdateFinished",
            ],
          },
          "source": [
            "superwerker",
          ],
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::Join": [
                "",
                [
                  "arn:",
                  {
                    "Ref": "AWS::Partition",
                  },
                  ":ssm:",
                  {
                    "Ref": "AWS::Region",
                  },
                  ":",
                  {
                    "Ref": "AWS::AccountId",
                  },
                  ":automation-definition/",
                  {
                    "Ref": "EnableGuardDutyOrganizations",
                  },
                ],
              ],
            },
            "Id": "EnableGuardDutyOrganizations",
            "RoleArn": {
              "Fn::GetAtt": [
                "SSMAutomationExecutionRoleforCWEvents",
                "Arn",
              ],
            },
          },
        ],
      },
      "Type": "AWS::Events::Rule",
    },
    "SSMAutomationExecutionRoleforCWEvents": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:StartAutomationExecution",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":ssm:",
                        {
                          "Ref": "AWS::Region",
                        },
                        ":",
                        {
                          "Ref": "AWS::AccountId",
                        },
                        ":automation-definition/",
                        {
                          "Ref": "EnableGuardDutyOrganizations",
                        },
                        ":*",
                      ],
                    ],
                  },
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "AllowStartAutomationExecution",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
  },
}
`;

