        "StackSetName": "superwerker-backup",
        "TemplateBody": {
          "Fn::Sub": "AWSTemplateFormatVersion: 2010-09-09
Description: Sets up backup service and remediation role for Superwerker Backup

Resources:
  AWSBackupDefaultServiceRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: AWSBackupDefaultServiceRole
      Path: /service-role/
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
          - Effect: Allow
            Principal:
              Service: backup.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:\${AWS::Partition}:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup
        - arn:\${AWS::Partition}:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForRestores

  ConfigRemediationRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: SuperwerkerBackupTagsEnforcementRemediationRole
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
          - Effect: Allow
            Principal:
              Service: ssm.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: AllowTagging
          PolicyDocument:
            Statement:
              - Effect: Allow
                Action:
                  - dynamodb:TagResource
                  - ec2:CreateTags
                  - rds:AddTagsToResource
                  - rds:DescribeDBInstances
                Resource: "*"
",
        },
      },
      "Type": "AWS::CloudFormation::StackSet",
    },
    "BackupTagRemediation": {
      "Properties": {
        "Content": {
          "assumeRole": "{{ AutomationAssumeRole }}",
          "mainSteps": [
            {
              "action": "aws:branch",
              "inputs": {
                "Choices": [
                  {
                    "NextStep": "tagDynamoDbTable",
                    "StringEquals": "AWS::DynamoDB::Table",
                    "Variable": "{{ ResourceType }}",
                  },
                  {
                    "NextStep": "tagEbsVolume",
                    "StringEquals": "AWS::EC2::Volume",
                    "Variable": "{{ ResourceType }}",
                  },
                  {
                    "NextStep": "getRdsDBInstanceArnByDbInstanceResourceIdentifier",
                    "StringEquals": "AWS::RDS::DBInstance",
                    "Variable": "{{ ResourceType }}",
                  },
                ],
              },
              "name": "synthArn",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "TagResource",
                "ResourceArn": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":dynamodb:{{ global:REGION }}:{{ global:ACCOUNT_ID }}:table/{{ ResourceValue }}",
                    ],
                  ],
                },
                "Service": "dynamodb",
                "Tags": [
                  {
                    "Key": "superwerker:backup",
                    "Value": "daily",
                  },
                ],
              },
              "isEnd": true,
              "name": "tagDynamoDbTable",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "CreateTags",
                "Resources": [
                  "{{ ResourceValue }}",
                ],
                "Service": "ec2",
                "Tags": [
                  {
                    "Key": "superwerker:backup",
                    "Value": "daily",
                  },
                ],
              },
              "isEnd": true,
              "name": "tagEbsVolume",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "DescribeDBInstances",
                "Filters": [
                  {
                    "Name": "dbi-resource-id",
                    "Values": [
                      "{{ ResourceValue }}",
                    ],
                  },
                ],
                "Service": "rds",
              },
              "name": "getRdsDBInstanceArnByDbInstanceResourceIdentifier",
              "outputs": [
                {
                  "Name": "DBInstanceArn",
                  "Selector": "$.DBInstances[0].DBInstanceArn",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "AddTagsToResource",
                "ResourceName": "{{ getRdsDBInstanceArnByDbInstanceResourceIdentifier.DBInstanceArn }}",
                "Service": "rds",
                "Tags": [
                  {
                    "Key": "superwerker:backup",
                    "Value": "daily",
                  },
                ],
              },
              "isEnd": true,
              "name": "tagRdsInstance",
            },
          ],
          "parameters": {
            "AutomationAssumeRole": {
              "default": "",
              "type": "String",
            },
            "ResourceType": {
              "type": "String",
            },
            "ResourceValue": {
              "type": "String",
            },
          },
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "BackupTagRemediationPublic": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "DocumentName": {
          "Ref": "BackupTagRemediation",
        },
        "ServiceToken": {
          "Fn::GetAtt": [
            "BackupTagRemediationPublicCustomResource",
            "Arn",
