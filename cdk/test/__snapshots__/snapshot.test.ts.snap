exports[`templates > SuperwerkerStack/SecurityHub matches snapshot 1`] = `
{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sets up SecurityHub with a delegated administor and automatically enabled for all AWS accounts in the AWS Organization. (qs-1s3rsr7n9)",
  "Resources": {
    "AcceptSecurityHubInvitation": {
      "Properties": {
        "Content": {
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "ListInvitations",
                "Service": "securityhub",
              },
              "name": "Invitation",
              "outputs": [
                {
                  "Name": "InvitationId",
                  "Selector": "$.Invitations[0].InvitationId",
                },
                {
                  "Name": "AccountId",
                  "Selector": "$.Invitations[0].AccountId",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "AcceptInvitation",
                "InvitationId": "{{ Invitation.InvitationId }}",
                "MasterId": "{{ Invitation.AccountId }}",
                "Service": "securityhub",
              },
              "name": "AcceptInvitation",
            },
          ],
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "CreateLandingZoneEnableSecurityHub": {
      "Properties": {
        "Content": {
          "assumeRole": {
            "Fn::GetAtt": "CreateLandingZoneEnableSecurityHubRole.Arn",
          },
          "mainSteps": [
            {
              "action": "aws:executeAutomation",
              "inputs": {
                "DocumentName": {
                  "Ref": "EnableSecurityHubInOrgAccount",
                },
                "RuntimeParameters": {
                  "AWSAccountId": [
                    "{{ AuditAccountId }}",
                  ],
                },
              },
              "name": "EnableSecurityHubInAuditAccount",
            },
            {
              "action": "aws:executeAutomation",
              "inputs": {
                "DocumentName": {
                  "Ref": "EnableSecurityHubInOrgAccountAndAddAsMember",
                },
                "RuntimeParameters": {
                  "MemberAWSAccountId": [
                    "{{ LogArchiveAccountId }}",
                  ],
                },
              },
              "name": "EnableSecurityHubMemberInOrgLogArchiveAccount",
            },
          ],
          "parameters": {
            "AuditAccountId": {
              "default": "{{ssm:/superwerker/account_id_audit}}",
              "type": "String",
            },
            "LogArchiveAccountId": {
              "default": "{{ssm:/superwerker/account_id_logarchive}}",
              "type": "String",
            },
          },
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "CreateLandingZoneEnableSecurityHubRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:StartAutomationExecution",
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:\${AWS::Partition}:ssm:\${AWS::Region}:\${AWS::AccountId}:automation-definition/\${EnableSecurityHubInOrgAccount}:*",
                    },
                    {
                      "Fn::Sub": "arn:\${AWS::Partition}:ssm:\${AWS::Region}:\${AWS::AccountId}:automation-definition/\${EnableSecurityHubInOrgAccountAndAddAsMember}:*",
                    },
                  ],
                },
                {
                  "Action": [
                    "ssm:GetAutomationExecution",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                },
              ],
            },
            "PolicyName": "AllowStartAutomationExecutionEnableSecurityHub",
          },
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:GetParameters",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:\${AWS::Partition}:ssm:\${AWS::Region}:\${AWS::AccountId}:parameter/superwerker/*",
                  },
                },
              ],
            },
            "PolicyName": "SSMParameters",
          },
        ],
      },
      "Type": "AWS::IAM::Role",
    },
    "CreateManagedAccountTrigger": {
      "Properties": {
        "EventPattern": {
          "detail": {
            "eventName": [
              "CreateManagedAccount",
            ],
            "serviceEventDetails": {
              "createManagedAccountStatus": {
                "state": [
                  "SUCCEEDED",
                ],
              },
            },
          },
          "detail-type": [
            "AWS Service Event via CloudTrail",
          ],
          "source": [
            "aws.controltower",
          ],
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::Sub": "arn:\${AWS::Partition}:ssm:\${AWS::Region}:\${AWS::AccountId}:automation-definition/\${EnableSecurityHubInOrgAccountAndAddAsMember}",
            },
            "Id": "CreateManagedAccountTrigger",
            "InputTransformer": {
              "InputPathsMap": {
                "AwsAccountId": "$.detail.serviceEventDetails.createManagedAccountStatus.account.accountId",
              },
              "InputTemplate": "{
  "MemberAWSAccountId": [<AwsAccountId>]
}
",
            },
            "RoleArn": {
              "Fn::GetAtt": "SSMAutomationExecutionRoleforCWEvents.Arn",
            },
          },
        ],
      },
      "Type": "AWS::Events::Rule",
    },
    "EnableSecurityHub": {
      "Properties": {
        "Content": {
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "DescribeHub",
                "Service": "securityhub",
              },
              "isCritical": false,
              "name": "CheckIfSecurityHubIsEnabled",
              "nextStep": "NoOp",
              "onFailure": "step:EnableSecurityHub",
            },
            {
              "action": "aws:sleep",
              "inputs": {
                "Duration": "PT0S",
              },
              "isEnd": true,
              "name": "NoOp",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "EnableSecurityHub",
                "Service": "securityhub",
              },
              "isEnd": true,
              "name": "EnableSecurityHub",
            },
          ],
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "EnableSecurityHubInOrgAccount": {
      "Properties": {
        "Content": {
          "assumeRole": {
            "Fn::GetAtt": "EnableSecurityHubInOrgAccountRole.Arn",
          },
          "mainSteps": [
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "StartAutomationExecution",
                "DocumentName": {
                  "Ref": "EnableSecurityHub",
                },
                "Service": "ssm",
                "TargetLocations": [
                  {
                    "Accounts": [
                      "{{ AWSAccountId }}",
                    ],
                    "ExecutionRoleName": "AWSControlTowerExecution",
                    "Regions": [
                      {
                        "Ref": "AWS::Region",
                      },
                    ],
                  },
                ],
              },
              "name": "EnableSecurityHubInOrgAccount",
              "nextStep": "WaitForEnableSecurityHubInOrgAccount",
              "outputs": [
                {
                  "Name": "AutomationExecutionId",
                  "Selector": "$.AutomationExecutionId",
                },
              ],
            },
            {
              "action": "aws:waitForAwsResourceProperty",
              "inputs": {
                "Api": "DescribeAutomationExecutions",
                "DesiredValues": [
                  "Success",
                ],
                "Filters": [
                  {
                    "Key": "ExecutionId",
                    "Values": [
                      "{{ EnableSecurityHubInOrgAccount.AutomationExecutionId }}",
                    ],
                  },
                ],
                "PropertySelector": "$.AutomationExecutionMetadataList[0].AutomationExecutionStatus",
                "Service": "ssm",
              },
              "name": "WaitForEnableSecurityHubInOrgAccount",
              "timeoutSeconds": 60,
            },
          ],
          "parameters": {
            "AWSAccountId": {
              "type": "String",
            },
          },
          "schemaVersion": "0.3",
        },
        "DocumentType": "Automation",
      },
      "Type": "AWS::SSM::Document",
    },
    "EnableSecurityHubInOrgAccountAndAddAsMember": {
      "Properties": {
        "Content": {
          "assumeRole": {
            "Fn::GetAtt": "EnableSecurityHubInOrgAccountAndAddAsMemberRole.Arn",
          },
          "mainSteps": [
            {
              "action": "aws:executeAutomation",
              "inputs": {
                "DocumentName": {
                  "Ref": "EnableSecurityHubInOrgAccount",
                },
                "RuntimeParameters": {
                  "AWSAccountId": [
                    "{{ MemberAWSAccountId }}",
                  ],
                },
              },
              "name": "EnableSecurityHubInOrgAccount",
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "AccountId": "{{ MemberAWSAccountId }}",
                "Api": "DescribeAccount",
                "Service": "organizations",
              },
              "name": "MemberAccount",
              "outputs": [
                {
                  "Name": "EmailAddress",
                  "Selector": "$.Account.Email",
                },
              ],
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "StartAutomationExecution",
                "DocumentName": {
                  "Ref": "InviteSecurityHubMember",
                },
                "Parameters": {
                  "MemberAWSAccountEmail": [
                    "{{ MemberAccount.EmailAddress }}",
                  ],
                  "MemberAWSAccountId": [
                    "{{ MemberAWSAccountId }}",
                  ],
                },
                "Service": "ssm",
                "TargetLocations": [
                  {
                    "Accounts": [
                      "{{ AuditAccountId }}",
                    ],
                    "ExecutionRoleName": "AWSControlTowerExecution",
                    "Regions": [
                      {
                        "Ref": "AWS::Region",
                      },
                    ],
                  },
                ],
              },
              "name": "InviteSecurityHubMember",
              "nextStep": "WaitForInviteSecurityHubMember",
              "outputs": [
                {
                  "Name": "AutomationExecutionId",
                  "Selector": "$.AutomationExecutionId",
                },
              ],
            },
            {
              "action": "aws:waitForAwsResourceProperty",
              "inputs": {
                "Api": "DescribeAutomationExecutions",
                "DesiredValues": [
                  "Success",
                ],
                "Filters": [
                  {
                    "Key": "ExecutionId",
                    "Values": [
                      "{{ InviteSecurityHubMember.AutomationExecutionId }}",
                    ],
                  },
                ],
                "PropertySelector": "$.AutomationExecutionMetadataList[0].AutomationExecutionStatus",
                "Service": "ssm",
              },
              "name": "WaitForInviteSecurityHubMember",
              "timeoutSeconds": 60,
            },
            {
              "action": "aws:executeAwsApi",
              "inputs": {
                "Api": "StartAutomationExecution",
                "DocumentName": {
                  "Ref": "AcceptSecurityHubInvitation",
                },
                "Service": "ssm",
                "TargetLocations": [
                  {
                    "Accounts": [
