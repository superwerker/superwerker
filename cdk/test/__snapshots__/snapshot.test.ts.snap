exports[`templates > SuperwerkerStack/Backup matches snapshot 1`] = `
{
  "Description": "Sets up backup configuration and policies.",
  "Resources": {
    "AWS679f53fac002430cb0da5b7982bd22872D164C4C": {
      "DependsOn": [
        "EnableCloudFormationStacksetsOrgAccessCustomResourceRole",
      ],
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Fn::Sub": "cdk-hnb659fds-assets-\${AWS::AccountId}-\${AWS::Region}",
          },
          "S3Key": "ASSET_HASH.zip",
        },
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "EnableCloudFormationStacksetsOrgAccessCustomResourceRole",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 120,
      },
      "Type": "AWS::Lambda::Function",
    },
    "BackupPolicy": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "BackupPolicyEnable",
      ],
      "Properties": {
        "Attach": true,
        "Policy": {
          "Fn::Join": [
            "",
            [
              "{"plans":{"superwerker-backup":{"regions":{"@@assign":["",
              {
                "Ref": "AWS::Region",
              },
              ""]},"rules":{"backup-daily":{"schedule_expression":{"@@assign":"cron(0 5 ? * * *)"},"lifecycle":{"delete_after_days":{"@@assign":30}},"target_backup_vault_name":{"@@assign":"Default"}}},"selections":{"tags":{"backup-daily":{"iam_role_arn":{"@@assign":"arn:aws:iam::$account:role/service-role/AWSBackupDefaultServiceRole"},"tag_key":{"@@assign":"superwerker:backup"},"tag_value":{"@@assign":["daily"]}}}}}}}",
            ],
          ],
