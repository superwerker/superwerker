    },
    "BackupTagsEnforcement": {
      "DependsOn": [
        "BackupResources",
      ],
      "Properties": {
        "DeliveryS3Bucket": {
          "Ref": "OrganizationConformancePackBucket",
        },
        "DeliveryS3KeyPrefix": "BackupTagsEnforcement",
        "ExcludedAccounts": [
