exports[`templates > SuperwerkerStack/Prepare matches snapshot 1`] = `
{
  "Description": "Prepares the AWS account for Superwerker.",
  "Resources": {
    "AWSControlTowerKMSKeyC9BA4F77": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "Description": "KMS key used by AWS Control Tower",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Statement": [
            {
              "Action": "kms:*",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition",
                      },
                      ":iam::",
                      {
                        "Ref": "AWS::AccountId",
                      },
                      ":root",
                    ],
                  ],
                },
              },
              "Resource": "*",
            },
            {
              "Action": [
                "kms:Decrypt",
                "kms:GenerateDataKey",
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": "config.amazonaws.com",
              },
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":kms:",
                    {
                      "Ref": "AWS::Region",
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":key/*",
                  ],
                ],
              },
              "Sid": "Allow Config to use KMS for encryption",
            },
            {
              "Action": [
                "kms:GenerateDataKey*",
                "kms:Decrypt",
              ],
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:",
                        {
                          "Ref": "AWS::Partition",
                        },
                        ":cloudtrail:",
                        {
                          "Ref": "AWS::Region",
                        },
                        ":",
                        {
